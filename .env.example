# Supabase
SUPABASE_URL=https://bwfxjqcravbfyiduewnz.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# CLI auth token for `supabase` commands (db push/pull, migrations). Get one at
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_your_cli_access_token_here

AI_MODEL_API_KEY=your_api_key_here
AI_MODEL_NAME=gemini-2.5-flash
PORT=3001

# AES-256-CBC master key (32 bytes hex) used to encrypt per-tenant Twilio auth tokens.
ENCRYPTION_KEY=replace_with_32_byte_hex_key

# Dashboard Login
# Generate a long random value for this secret.
DASHBOARD_SESSION_SECRET=replace_with_a_long_random_secret
# Either a JSON array or object is supported. tenantId must match business_profiles.id.
DASHBOARD_TENANT_CREDENTIALS=[{"email":"tenant@example.com","password":"change-me","tenantId":"00000000-0000-0000-0000-000000000000"}]
# Used to authorize server-side cron calls to /api/cron/cleanup.
CRON_SECRET=replace_with_a_long_random_secret_for_cron

# Twilio Credentials (global fallback — tenants can override via business_profiles)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your_token_here
TWILIO_PHONE_NUMBER=+1...
# Leave unset to derive the callback URL from the request host per environment
# (local/dev/prod) -> /api/twilio/status
# TWILIO_STATUS_CALLBACK_URL=
# Missed-call SMS fallback text (used when the WhatsApp follow-up fails/is
# unavailable). Supports {{agent}} and {{salon}} tokens, substituted per-tenant.
# TWILIO_INBOUND_CALL_SMS_BODY=Hi 👋, I'm {{agent}}, {{salon}}'s virtual assistant.\n\nSorry we've missed you call. What service are you looking to book? ✨

# Twilio WhatsApp (fallback sender + business-initiated outreach template).
# Per-tenant senders live in business_profiles.whatsapp_number; these are the
# global fallbacks used when a tenant hasn't configured their own.
TWILIO_WHATSAPP_NUMBER=+1...
# Content SID of the pre-approved WhatsApp template used for dashboard-initiated
# outreach (required outside the 24h customer-service window).
TWILIO_WHATSAPP_TEMPLATE_SID=HX...
# Owner-facing preview text shown in the dashboard "Start Conversation" modal.
# Should match what the approved template actually renders. Use the literal
# token {{agent}} where the template has its named variable — the dashboard
# substitutes the salon's real agent name (business_profiles.agent_name) into
# this placeholder for the preview, and the API does the same in contentVariables.
NEXT_PUBLIC_WHATSAPP_TEMPLATE_PREVIEW=Hi! This is {{agent}} from your salon. Reply here and we can help you book an appointment.

# Message rate card (USD) — recorded per row on sms_messages as a cost estimate,
# separate from Twilio's own reported price. Override to match your Twilio invoice.
#
# SMS is billed PER SEGMENT (160 GSM-7 chars, 153/segment when concatenated;
# 70/67 for Unicode), so these are per-segment rates, not per message.
SMS_OUTBOUND_SEGMENT_FEE_USD=0.056
SMS_INBOUND_SEGMENT_FEE_USD=0.0075
# Charged once on messages that end up failed/undelivered. Set to 0 to disable.
SMS_FAILED_MESSAGE_FEE_USD=0.001
# WhatsApp is per message: Meta's fee applies to sends outside the 24h customer
# service window and to template sends; Twilio's platform fee applies to every
# WhatsApp message in both directions.
WHATSAPP_META_FEE_USD=0.022
WHATSAPP_TWILIO_FEE_USD=0.005

# Cal.com Credentials
CAL_COM_API_KEY=cal_...
CAL_COM_EVENT_TYPE_ID=123456

# Email Notifications (Owner Alerts)
RESEND_API_KEY=re_...
RESEVIA_NOTIFICATIONS_FROM=Resevia Alerts <notifications@resevia.com>

# Google Cloud Logging (error tracking)
GCP_PROJECT_ID=your_gcp_project_id
# Full service-account JSON credentials, as a single-line string.
GCP_LOGGING_CREDENTIALS={"type":"service_account",...}
